# Copy to .env and adjust. Never commit real API keys.

# ── Morning Light Nebius Eyes (Nebius×NVIDIA hackathon) ──
# Get $25 credits: Devpost form activation code NEBIUS-DEVPOST-GLOBAL26
# https://nebius.com/services/token-factory

# Required for live Nemotron analysis (optional for offline demo)
# NEBIUS_API_KEY=

# Nebius Token Factory OpenAI-compatible endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Small NVIDIA open model on Token Factory (change after: python -m desk_sentinel.nebius_eyes models)
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# auto | demo | live — auto uses live when NEBIUS_API_KEY is set
NEBIUS_EYES_MODE=auto

# ── Morning Light Desk Sentinel (AWS Agents for Humans demo) ──
# demo (default) | openai | bedrock
DESK_MODEL_MODE=demo

# Identity shown in reports and mock notifications
DESK_OWNER_SIGN=✝️🧿🪬
DESK_ASSISTANT_SIGN=3️⃣🧿5️⃣
DESK_OPERATOR=elghaly / Wyndham Heaven

# Optional — only when DESK_MODEL_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL_ID=gpt-4o-mini

# Optional — only when DESK_MODEL_MODE=bedrock
# AWS_REGION=us-west-2
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
